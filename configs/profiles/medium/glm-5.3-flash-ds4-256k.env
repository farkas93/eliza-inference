SERVICE_NAME="eliza-medium"
BACKEND="ds4"
DS4_MODEL_PRESET="glm53-q2"
MODEL_DIR="${DS4_DIR:-$HOME/src/ds4}/gguf"
MODEL_FILE="GLM-5.3-Flash-Q2.gguf"
MODEL_NAME="glm-5.3-flash"
HOST="${DEFAULT_HOST:-0.0.0.0}"
PORT="${ELIZA_MEDIUM_PORT:-8001}"
CTX_SIZE="262144"
DS4_BACKEND_DEVICE="cuda"
DS4_POWER="100"
DS4_MTP="true"
DS4_KV_TO_DISK="true"
DS4_KV_MB=16384
