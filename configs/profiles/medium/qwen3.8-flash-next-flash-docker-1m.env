SERVICE_NAME="eliza-medium"
BACKEND="flash"
FLASH_REPO="${FLASH_REPO:-$HOME/src/qwen3.8-Flash-DGX}"
FLASH_IMAGE="${FLASH_IMAGE:-qwen38-flash-dgx}"
FLASH_CONTAINER="${FLASH_CONTAINER:-qwen38-flash}"
FLASH_MODEL="${FLASH_MODEL:-nvidia/Qwen3.8-Flash-Next-NVFP4}"
FLASH_MODE="hybrid"
FLASH_YARN="1"
FLASH_MTP="2"
FLASH_SEQS="8"
FLASH_GPU_MEM="0.80"
FLASH_KV_DTYPE="fp8_e4m3"
FLASH_PREFIX_CACHE="1"
FLASH_COMPILE_CACHE="${FLASH_COMPILE_CACHE:-qwen38-flash}"
MODEL_NAME="qwen3.8-flash-next"
HOST="${DEFAULT_HOST:-0.0.0.0}"
PORT="${ELIZA_MEDIUM_PORT:-8001}"
CTX_SIZE="1000000"
