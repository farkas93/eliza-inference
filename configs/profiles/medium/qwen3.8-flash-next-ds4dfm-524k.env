SERVICE_NAME="eliza-medium"
BACKEND="ds4dfm"
MODEL_DIR="$MODEL_HOME/ds4dfm"
MODEL_FILE="MQ-Q5-SSD-PLE-BF16/Qwen3.8-Flash-Next-MQ-Q5-SSD-PLE-BF16-00001-of-00003.gguf"
SIDECAR_DIR="MQ-Q5-SSD-PLE-BF16/ple"
MODEL_NAME="qwen3.8-flash-next"
DS4DFM_MODEL_ID="qwen3.8-flash-next"
HOST="${DEFAULT_HOST:-0.0.0.0}"
PORT="${ELIZA_MEDIUM_PORT:-8001}"
CTX_SIZE="524288"
DS4DFM_BACKEND_DEVICE="cuda"
DS4DFM_MAX_SEQS="1"
# 524k context requires minimizing memory overhead on a 128GB DGX Spark
# to fit the engine memory quote (MTP off, lean floor, 512M PLE cache)
DS4DFM_MTP_DRAFT="0"
DS4DFM_MEM_FLOOR_GB="1"
DS4DFM_MEMGOV="observe"
DS4DFM_PREFIX_REUSE="auto"
DS4DFM_QWEN_BATCH="1"
DS4DFM_QWEN_PLE_CACHE_MB="512"
DS4DFM_QWEN_PLE_WORKERS="16"
DS4DFM_QWEN_PREFILL_CHUNK="8192"
DS4DFM_KV_TO_DISK="true"
DS4DFM_KV_MB=32768
