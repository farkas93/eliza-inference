SERVICE_NAME="eliza-medium"
BACKEND="llamacpp"
LLAMA_RUNTIME="unsloth-mtp"
MODEL_REPO="unsloth/Qwen3.8-Flash-Next-GGUF"
MODEL_DIR="$MODEL_HOME/Qwen3.8-Flash-Next-GGUF"
MODEL_FILE="UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf"
HF_INCLUDE_MODEL="*UD-Q4_K_XL*"
DRAFT_MODEL_FILE="MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf"
SPEC_TYPE="draft-mtp"
SPEC_DRAFT_N_MAX="3"
MODEL_NAME="qwen3.8-flash-next"
HOST="${DEFAULT_HOST:-0.0.0.0}"
PORT="${ELIZA_MEDIUM_PORT:-8001}"
CTX_SIZE="32768"
BATCH_SIZE="512"
UBATCH_SIZE="512"
N_GPU_LAYERS="999"
JINJA="true"
FLASH_ATTN="on"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
PARALLEL="1"
FIT="off"
OVERRIDE_TENSOR="per_layer_token_embd=CPU,ple_ngram_embd=CPU"
