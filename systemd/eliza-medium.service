[Unit]
Description=Eliza Medium Reasoning Model Endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
KillMode=process
OOMPolicy=continue
WorkingDirectory=%h/private/eliza-inference
ExecStart=%h/private/eliza-inference/scripts/start eliza-medium --profile medium/qwen3.8-flash-next-ud-iq4-xs-llamacpp-mtp-256k
ExecStop=%h/private/eliza-inference/scripts/stop eliza-medium
# The supervisor inside tmux owns model crash recovery.

[Install]
WantedBy=default.target
