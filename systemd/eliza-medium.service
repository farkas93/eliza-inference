[Unit]
Description=Eliza Medium Reasoning Model Endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
WorkingDirectory=%h/private/eliza-inference
ExecStart=%h/private/eliza-inference/scripts/start eliza-medium --profile medium/qwen3.8-27b-fp8-sglang-256k
ExecStop=%h/private/eliza-inference/scripts/stop eliza-medium --profile medium/qwen3.8-27b-fp8-sglang-256k
Restart=on-failure

[Install]
WantedBy=default.target
