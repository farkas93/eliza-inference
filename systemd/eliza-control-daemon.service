[Unit]
Description=Eliza Inference REST Control Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/private/eliza-inference
ExecStart=%h/private/eliza-inference/.venv/bin/python -m uvicorn services.control_daemon.app:app --host 0.0.0.0 --port 8030
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
