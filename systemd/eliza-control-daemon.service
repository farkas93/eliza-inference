[Unit]
Description=Eliza Inference REST Control Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/eliza-inference
Environment="PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=%h/eliza-inference/services/control-daemon/start.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
