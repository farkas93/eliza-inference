#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLI_MAIN="$ROOT_DIR/eliza-cli/main.py"
CLI_REQUIREMENTS="$ROOT_DIR/eliza-cli/requirements.txt"
BIN_DIR="${ELIZA_CLI_BIN_DIR:-$HOME/.local/bin}"
BIN_PATH="$BIN_DIR/eliza-cli"
AUTO_SHELL_RC="true"

print_help() {
  cat <<USAGE
Usage: ./install-cli [options]

Installs a PATH-based eliza-cli launcher under ~/.local/bin.

Options:
  --no-shell-rc   Do not edit shell rc files.
  -h, --help      Show this help message.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-shell-rc)
      AUTO_SHELL_RC="false"
      shift
      ;;
    -h|--help)
      print_help
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

install_uv() {
  if command -v uv >/dev/null 2>&1; then
    return 0
  fi

  if ! command -v curl >/dev/null 2>&1; then
    echo "uv is missing and curl is not available to install it." >&2
    return 1
  fi

  echo "Installing uv with the official installer..."
  curl -LsSf https://astral.sh/uv/install.sh | sh
  export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

  if ! command -v uv >/dev/null 2>&1; then
    echo "uv installation finished, but uv is still not on PATH." >&2
    echo "Open a new shell or add ~/.local/bin to PATH, then rerun ./install-cli." >&2
    return 1
  fi
}

add_path_block() {
  local rc_file="$1"
  local begin="# >>> eliza-cli path >>>"
  local end="# <<< eliza-cli path <<<"

  if [[ ! -f "$rc_file" ]]; then
    touch "$rc_file"
  fi

  if grep -q "$begin" "$rc_file"; then
    return 0
  fi

  {
    printf "\n%s\n" "$begin"
    printf "if [ -d \"$HOME/.local/bin\" ]; then\n"
    printf "  case \":$PATH:\" in\n"
    printf "    *:\"$HOME/.local/bin\":*) ;;\n"
    printf "    *) export PATH=\"$HOME/.local/bin:$PATH\" ;;\n"
    printf "  esac\n"
    printf "fi\n"
    printf "%s\n" "$end"
  } >> "$rc_file"

  echo "Updated $rc_file with ~/.local/bin PATH block"
}

add_bash_completion_block() {
  local rc_file="$1"
  local begin="# >>> eliza-cli completion >>>"
  local end="# <<< eliza-cli completion <<<"

  if [[ ! -f "$rc_file" ]]; then
    touch "$rc_file"
  fi

  if grep -q "$begin" "$rc_file"; then
    return 0
  fi

  {
    printf "\n%s\n" "$begin"
    printf "if [ -f \"$HOME/.local/share/bash-completion/completions/eliza-cli\" ]; then\n"
    printf "  . \"$HOME/.local/share/bash-completion/completions/eliza-cli\"\n"
    printf "fi\n"
    printf "%s\n" "$end"
  } >> "$rc_file"

  echo "Updated $rc_file with bash completion source block"
}

add_zsh_fpath_block() {
  local rc_file="$1"
  local begin="# >>> eliza-cli completion >>>"
  local end="# <<< eliza-cli completion <<<"

  if [[ ! -f "$rc_file" ]]; then
    touch "$rc_file"
  fi

  if grep -q "$begin" "$rc_file"; then
    return 0
  fi

  {
    printf "\n%s\n" "$begin"
    printf "fpath=(\"$HOME/.zsh/completions\" \$fpath)\n"
    printf "autoload -Uz compinit && compinit\n"
    printf "%s\n" "$end"
  } >> "$rc_file"

  echo "Updated $rc_file with zsh fpath block"
}

install_completions() {
  local bash_dir="$HOME/.local/share/bash-completion/completions"
  local zsh_dir="$HOME/.zsh/completions"
  mkdir -p "$bash_dir" "$zsh_dir"

  if "$BIN_PATH" completion bash > "$bash_dir/eliza-cli" 2>/dev/null; then
    echo "Installed bash completion: $bash_dir/eliza-cli"
  else
    rm -f "$bash_dir/eliza-cli"
    echo "Warning: could not generate bash completion." >&2
  fi

  if "$BIN_PATH" completion zsh > "$zsh_dir/_eliza-cli" 2>/dev/null; then
    echo "Installed zsh completion: $zsh_dir/_eliza-cli"
  else
    rm -f "$zsh_dir/_eliza-cli"
    echo "Warning: could not generate zsh completion." >&2
  fi
}

if [[ ! -f "$CLI_MAIN" ]]; then
  echo "CLI entrypoint is missing: $CLI_MAIN" >&2
  exit 1
fi

if [[ ! -f "$CLI_REQUIREMENTS" ]]; then
  echo "CLI requirements file is missing: $CLI_REQUIREMENTS" >&2
  exit 1
fi

install_uv
mkdir -p "$BIN_DIR"

cat > "$BIN_PATH" <<EOF
#!/usr/bin/env bash
set -euo pipefail
exec uv run --python 3.12 --with-requirements "$CLI_REQUIREMENTS" "$CLI_MAIN" "\$@"
EOF

chmod +x "$BIN_PATH"
echo "Installed launcher: $BIN_PATH"

if [[ "$AUTO_SHELL_RC" == "true" ]]; then
  add_path_block "$HOME/.bashrc"
  add_path_block "$HOME/.zshrc"
  add_bash_completion_block "$HOME/.bashrc"
  add_zsh_fpath_block "$HOME/.zshrc"
fi

export PATH="$BIN_DIR:$PATH"

install_completions

if "$BIN_PATH" list >/dev/null 2>&1; then
  echo "eliza-cli installation verified."
  echo "Run: eliza-cli tui"
else
  echo "Launcher installed, but verification failed. Try running: $BIN_PATH list" >&2
  exit 1
fi
