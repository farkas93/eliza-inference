#!/usr/bin/env bash
set -euo pipefail

COMMAND_NAME="status"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
source "$ROOT_DIR/scripts/lib/common.sh"
load_env
parse_service_profile "$@"
source_profile

if command -v tmux >/dev/null 2>&1 && tmux_has_session; then
  phase="running"
  if [[ "$SERVICE" == "eliza-medium" ]]; then
    supervisor_python="$(service_control_python)"
    supervisor_phase="$("$supervisor_python" "$ROOT_DIR/scripts/lib/service_supervisor.py" status --state "$SERVICE_SUPERVISOR_DIR/$SERVICE.supervisor.json" --field status)"
    case "$supervisor_phase" in
      backoff | recovering) phase="restarting" ;;
      starting | stopping | failed) phase="$supervisor_phase" ;;
    esac
  fi
  echo "$phase: $SERVICE ($SESSION_NAME)"
else
  echo "stopped: $SERVICE ($SESSION_NAME)"
fi

if [[ "$SERVICE" == "eliza-medium" ]]; then
  supervisor_python="$(service_control_python)"
  "$supervisor_python" "$ROOT_DIR/scripts/lib/service_supervisor.py" status --state "$SERVICE_SUPERVISOR_DIR/$SERVICE.supervisor.json"
fi

if [[ -x "$SERVICE_DIR/healthcheck.sh" ]]; then
  "$SERVICE_DIR/healthcheck.sh" || true
fi
