#!/usr/bin/env bash
set -euo pipefail

COMMAND_NAME="token-generation"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck disable=SC1091
source "$ROOT_DIR/scripts/lib/common.sh"
load_env

SERVICE="${1:-}"
if [[ "$SERVICE" == "-h" || "$SERVICE" == "--help" ]]; then
  cat <<USAGE
Usage: ./scripts/run-benchmark token-generation <service> [--profile <profile-name>] [options]

Options:
  --max-tokens <n>       Completion token cap (default: 256)
  --context-tokens <n>   Add approximate synthetic context before prompt
  --prompt <text>        Prompt to send
  --prompt-file <path>   Read prompt from file
  --show-raw             Print raw SSE events before the JSON summary
  --show-deltas          Print parsed content/reasoning deltas
  --force                Skip the running-model consistency check

Examples:
  ./scripts/run-benchmark token-generation eliza-medium --profile medium/qwen3.8-27b-fp8-sglang-256k --show-raw
  ./scripts/run-benchmark token-generation eliza-medium --profile medium/qwen3.6-35b-a3b-q4-llamacpp-256k --max-tokens 1024
USAGE
  exit 0
fi
shift || true
PROFILE=""
MAX_TOKENS="256"
CONTEXT_TOKENS="0"
PROMPT=""
PROMPT_FILE=""
SHOW_RAW="false"
SHOW_DELTAS="false"
FORCE="false"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      PROFILE="${2:-}"
      shift 2
      ;;
    --max-tokens)
      MAX_TOKENS="${2:-}"
      shift 2
      ;;
    --context-tokens)
      CONTEXT_TOKENS="${2:-}"
      shift 2
      ;;
    --prompt)
      PROMPT="${2:-}"
      shift 2
      ;;
    --prompt-file)
      PROMPT_FILE="${2:-}"
      shift 2
      ;;
    --show-raw)
      SHOW_RAW="true"
      shift
      ;;
    --show-deltas)
      SHOW_DELTAS="true"
      shift
      ;;
    --force)
      FORCE="true"
      shift
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

set -- "$SERVICE"
if [[ -n "$PROFILE" ]]; then
  set -- "$SERVICE" --profile "$PROFILE"
fi
parse_service_profile "$@"

source_profile
base_url="http://127.0.0.1:${PORT}/v1"
model="${MODEL_NAME:-${MODEL_ID:-${MODEL_FILE:-local-model}}}"
timestamp="$(date +%Y%m%d-%H%M%S)"
profile_slug="${PROFILE:-default}"
profile_slug="${profile_slug//\//-}"
output="$ROOT_DIR/benchmarks/results/${SERVICE}-${profile_slug}-stream-${timestamp}.json"

if [[ ! -x "$BASE_VENV/bin/python" ]]; then
  echo "Base venv missing. Run ./scripts/setup prerequisites first." >&2
  exit 1
fi

if [[ "$FORCE" != "true" ]]; then
  expected_models=(--expected "$model")
  if [[ -n "${MODEL_FILE:-}" ]]; then
    expected_models+=("--expected" "$(basename "$MODEL_FILE")")
  fi
  "$BASE_VENV/bin/python" "$ROOT_DIR/scripts/lib/verify_service_model.py" \
    --base-url "$base_url" \
    --service "$SERVICE" \
    --profile "${PROFILE:-default}" \
    "${expected_models[@]}"
fi

args=(
  --base-url "$base_url"
  --model "$model"
  --service "$SERVICE"
  --profile "${PROFILE:-default}"
  --max-tokens "$MAX_TOKENS"
  --context-tokens "$CONTEXT_TOKENS"
  --output-json "$output"
)

if [[ -n "$PROMPT" ]]; then
  args+=(--prompt "$PROMPT")
fi
if [[ -n "$PROMPT_FILE" ]]; then
  args+=(--prompt-file "$PROMPT_FILE")
fi
if [[ "$SHOW_RAW" == "true" ]]; then
  args+=(--show-raw)
fi
if [[ "$SHOW_DELTAS" == "true" ]]; then
  args+=(--show-deltas)
fi

"$BASE_VENV/bin/python" "$ROOT_DIR/clients/openai/stream_inspect.py" "${args[@]}"

echo "Saved benchmark: $output"

"$BASE_VENV/bin/python" "$ROOT_DIR/scripts/lib/benchmark_ledger.py" add \
  --ledger "$ROOT_DIR/benchmarks/results/runs.jsonl" \
  --type "token-generation" \
  --service "$SERVICE" \
  --profile "${PROFILE:-default}" \
  --result-json "$output" || echo "warning: failed to append benchmark ledger entry" >&2
