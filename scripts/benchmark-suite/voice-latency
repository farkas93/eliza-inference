#!/usr/bin/env bash
set -euo pipefail

COMMAND_NAME="voice-latency"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck disable=SC1091
source "$ROOT_DIR/scripts/lib/common.sh"
load_env

ROUNDS=3
OUTPUT_DIR="$ROOT_DIR/benchmarks/results"
FORCE="false"
POSITIONAL=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      cat <<HELP
Usage: ./scripts/run-benchmark voice-latency <service> [options]

Options:
  --profile <profile>  Profile path (default: service default)
  --rounds <N>         Number of test rounds (default: 3)
  --force              Skip the running-model consistency check
  --help               Show this help

Examples:
  ./scripts/run-benchmark voice-latency eliza-small
  ./scripts/run-benchmark voice-latency eliza-small --profile small/gemma4-e4b-q4-llamacpp-128k --rounds 5
HELP
      exit 0
      ;;
    --rounds)
      if [[ $# -ge 2 ]]; then
        ROUNDS="$2"
        shift 2
      else
        echo "--rounds requires a value" >&2
        exit 2
      fi
      ;;
    --force)
      FORCE="true"
      shift
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

parse_service_profile "${POSITIONAL[@]}"

source_profile
base_url="http://127.0.0.1:${PORT}/v1"
model="${MODEL_NAME:-${MODEL_ID:-${MODEL_FILE:-local-model}}}"

if [[ ! -x "$BASE_VENV/bin/python" ]]; then
  echo "Base venv missing. Run ./scripts/setup prerequisites first." >&2
  exit 1
fi

if [[ "$FORCE" != "true" ]]; then
  expected_models=(--expected "$model")
  if [[ -n "${MODEL_FILE:-}" ]]; then
    expected_models+=("--expected" "$(basename "$MODEL_FILE")")
  fi
  "$BASE_VENV/bin/python" "$ROOT_DIR/scripts/lib/verify_service_model.py" \
    --base-url "$base_url" \
    --service "$SERVICE" \
    --profile "${PROFILE:-default}" \
    "${expected_models[@]}"
fi

mkdir -p "$OUTPUT_DIR"
timestamp="$(date -u +%Y%m%dT%H%M%S)"
output_file="$OUTPUT_DIR/${SERVICE}-${PROFILE##*/}-voice-latency-${timestamp}.json"

"$BASE_VENV/bin/python" "$ROOT_DIR/clients/openai/voice_test.py" \
  --base-url "$base_url" \
  --model "$model" \
  --service "$SERVICE" \
  --profile "${PROFILE:-default}" \
  --rounds "$ROUNDS" \
  --output-json "$output_file"

echo "Results written to: $output_file"

"$BASE_VENV/bin/python" "$ROOT_DIR/scripts/lib/benchmark_ledger.py" add \
  --ledger "$ROOT_DIR/benchmarks/results/runs.jsonl" \
  --type "voice-latency" \
  --service "$SERVICE" \
  --profile "${PROFILE:-default}" \
  --result-json "$output_file" || echo "warning: failed to append benchmark ledger entry" >&2
