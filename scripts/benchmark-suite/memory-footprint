#!/usr/bin/env bash
set -euo pipefail

COMMAND_NAME="memory-footprint"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck disable=SC1091
source "$ROOT_DIR/scripts/lib/common.sh"
load_env

SERVICE="${1:-}"
shift || true
PROFILE=""
CONTEXT_TOKENS="32768"
CONTEXT_TOKENS_LIST=""
MAX_TOKENS="64"
SAMPLE_COUNT="3"
SAMPLE_INTERVAL="1"
OUTPUT_JSON=""
FORCE="false"

if [[ -z "$SERVICE" || "$SERVICE" == "-h" || "$SERVICE" == "--help" ]]; then
  cat <<USAGE
Usage: ./scripts/run-benchmark memory-footprint <service> [options]

Options:
  --profile <name>             Profile override
  --context-tokens <n>         Single context target (default: 32768)
  --context-tokens-list <csv>  Multiple targets, example: 8192,32768,131072
  --max-tokens <n>             Completion token cap for context requests (default: 64)
  --samples <n>                nvidia-smi samples per snapshot (default: 3)
  --interval <sec>             Seconds between samples (default: 1)
  --output-json <path>         Explicit output path (default: benchmarks/results/...)
  --force                      Skip the running-model consistency check

Examples:
  ./scripts/run-benchmark memory-footprint eliza-medium --profile medium/qwen3.8-27b-fp8-sglang-256k
  ./scripts/run-benchmark memory-footprint eliza-medium --context-tokens-list 8192,32768,131072
USAGE
  exit 0
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      PROFILE="${2:-}"
      shift 2
      ;;
    --context-tokens)
      CONTEXT_TOKENS="${2:-}"
      shift 2
      ;;
    --context-tokens-list)
      CONTEXT_TOKENS_LIST="${2:-}"
      shift 2
      ;;
    --max-tokens)
      MAX_TOKENS="${2:-}"
      shift 2
      ;;
    --samples)
      SAMPLE_COUNT="${2:-}"
      shift 2
      ;;
    --interval)
      SAMPLE_INTERVAL="${2:-}"
      shift 2
      ;;
    --output-json)
      OUTPUT_JSON="${2:-}"
      shift 2
      ;;
    --force)
      FORCE="true"
      shift
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

if ! command -v nvidia-smi >/dev/null 2>&1; then
  echo "nvidia-smi is not available" >&2
  exit 1
fi

if [[ ! -x "$BASE_VENV/bin/python" ]]; then
  echo "Base venv missing. Run ./scripts/setup prerequisites first." >&2
  exit 1
fi

set -- "$SERVICE"
if [[ -n "$PROFILE" ]]; then
  set -- "$SERVICE" --profile "$PROFILE"
fi
parse_service_profile "$@"

if [[ "$SERVICE" != "eliza-small" && "$SERVICE" != "eliza-medium" ]]; then
  echo "memory-footprint currently supports eliza-small or eliza-medium." >&2
  exit 2
fi

source_profile
base_url="http://127.0.0.1:${PORT}/v1"
model="${MODEL_NAME:-${MODEL_ID:-${MODEL_FILE:-local-model}}}"

if [[ "$FORCE" != "true" ]]; then
  expected_models=(--expected "$model")
  if [[ -n "${MODEL_FILE:-}" ]]; then
    expected_models+=("--expected" "$(basename "$MODEL_FILE")")
  fi
  "$BASE_VENV/bin/python" "$ROOT_DIR/scripts/lib/verify_service_model.py" \
    --base-url "$base_url" \
    --service "$SERVICE" \
    --profile "${PROFILE:-default}" \
    "${expected_models[@]}"
fi

timestamp="$(date +%Y%m%d-%H%M%S)"
profile_slug="${PROFILE:-$SERVICE}"
profile_slug="${profile_slug//\//-}"

if [[ -z "$OUTPUT_JSON" ]]; then
  OUTPUT_JSON="$ROOT_DIR/benchmarks/results/${profile_slug}-memory-footprint-${timestamp}.json"
fi
mkdir -p "$(dirname "$OUTPUT_JSON")"

detect_memory_source() {
  local value
  value="$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null | head -n 1 | tr -d '[:space:]' || true)"
  if [[ "$value" =~ ^[0-9]+$ ]]; then
    echo "nvidia-smi"
  else
    echo "system-unified"
  fi
}

system_memory_mb() {
  # Prints "<used_mb> <total_mb>" to one decimal place.
  if command -v free >/dev/null 2>&1; then
    free -b | awk '/^Mem:/ {printf "%.1f %.1f\n", ($2 - $7) / 1048576, $2 / 1048576}'
  else
    awk '/^MemTotal:/ {t = $2} /^MemAvailable:/ {a = $2} END {printf "%.1f %.1f\n", (t - a) / 1024, t / 1024}' /proc/meminfo
  fi
}

capture_unified_snapshot() {
  local output_file="$1"
  local gpu_name sample_index utilization used_mb total_mb
  gpu_name="$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -n 1 || true)"
  [[ -n "$gpu_name" ]] || gpu_name="NVIDIA GB10"
  : >"$output_file"
  for sample_index in $(seq 1 "$SAMPLE_COUNT"); do
    read -r used_mb total_mb < <(system_memory_mb)
    if [[ -z "${used_mb:-}" || -z "${total_mb:-}" ]]; then
      echo "Failed to read system memory (tried 'free -b' and /proc/meminfo)" >&2
      return 1
    fi
    utilization="$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null | head -n 1 | tr -d '[:space:]' || true)"
    [[ "$utilization" =~ ^[0-9]+$ ]] || utilization=0
    echo "$(date '+%a %b %d %H:%M:%S %Y'),${gpu_name},${used_mb},${total_mb},${utilization}" >>"$output_file"
    if [[ "$sample_index" -lt "$SAMPLE_COUNT" ]]; then
      sleep "$SAMPLE_INTERVAL"
    fi
  done
}

MEMORY_SOURCE="$(detect_memory_source)"
echo "Memory source: $MEMORY_SOURCE"

capture_snapshot() {
  local label="$1"
  local output_file="$2"
  if [[ "$MEMORY_SOURCE" == "nvidia-smi" ]]; then
    nvidia-smi --query-gpu=timestamp,name,memory.used,memory.total,utilization.gpu --format=csv,noheader,nounits -l "$SAMPLE_INTERVAL" -c "$SAMPLE_COUNT" >"$output_file"
  else
    capture_unified_snapshot "$output_file"
  fi
  echo "Captured $label snapshot: $output_file"
}

run_context_request() {
  local tokens="$1"
  local result_file="$2"
  "$BASE_VENV/bin/python" "$ROOT_DIR/clients/openai/long_context_test.py" \
    --base-url "$base_url" \
    --model "$model" \
    --tokens "$tokens" \
    --max-tokens "$MAX_TOKENS" \
    --output-json "$result_file"
}

tmp_dir="$ROOT_DIR/tmp/memory-footprint-${SERVICE}-${timestamp}"
mkdir -p "$tmp_dir"

baseline_csv="$tmp_dir/baseline.csv"
post_load_csv="$tmp_dir/post-load.csv"
warmup_json="$tmp_dir/warmup.json"

capture_snapshot "baseline" "$baseline_csv"
run_context_request 1024 "$warmup_json"
capture_snapshot "post-load" "$post_load_csv"

context_targets=()
if [[ -n "$CONTEXT_TOKENS_LIST" ]]; then
  IFS=',' read -r -a context_targets <<<"$CONTEXT_TOKENS_LIST"
else
  context_targets=("$CONTEXT_TOKENS")
fi

context_results_lines=()
for target in "${context_targets[@]}"; do
  target_trimmed="$(echo "$target" | tr -d '[:space:]')"
  [[ -z "$target_trimmed" ]] && continue
  request_json="$tmp_dir/context-${target_trimmed}.json"
  snapshot_csv="$tmp_dir/context-${target_trimmed}.csv"
  run_context_request "$target_trimmed" "$request_json"
  capture_snapshot "context-$target_trimmed" "$snapshot_csv"
  context_results_lines+=("$target_trimmed:$request_json:$snapshot_csv")
done

python_args=(
  "$OUTPUT_JSON"
  "$SERVICE"
  "${PROFILE:-default}"
  "$model"
  "$MEMORY_SOURCE"
  "$baseline_csv"
  "$post_load_csv"
  "$warmup_json"
)
for item in "${context_results_lines[@]}"; do
  python_args+=("$item")
done

"$BASE_VENV/bin/python" "$ROOT_DIR/scripts/lib/benchmark_report.py" "${python_args[@]}"

echo "Saved benchmark: $OUTPUT_JSON"

"$BASE_VENV/bin/python" "$ROOT_DIR/scripts/lib/benchmark_ledger.py" add \
  --ledger "$ROOT_DIR/benchmarks/results/runs.jsonl" \
  --type "memory-footprint" \
  --service "$SERVICE" \
  --profile "${PROFILE:-default}" \
  --result-json "$OUTPUT_JSON" || echo "warning: failed to append benchmark ledger entry" >&2
