#!/usr/bin/env bash
set -euo pipefail

COMMAND_NAME="start"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
source "$ROOT_DIR/scripts/lib/common.sh"
load_env
parse_service_profile "$@"

require_command tmux
mkdir -p "$LOG_DIR"

if tmux_has_session; then
  live_profile="$(runtime_state get --state "$RUNTIME_STATE_FILE" --service "$SERVICE" 2>/dev/null || true)"
  live_profile_path=""
  if [[ -n "$live_profile" ]]; then
    live_profile_path="$(resolve_profile_path "$live_profile" || true)"
  fi

  if [[ -n "$live_profile_path" && "$live_profile_path" == "$PROFILE_PATH" ]]; then
    echo "Service already running with requested profile: $SERVICE ($live_profile)"
    exit 0
  fi

  if [[ -n "$live_profile" ]]; then
    echo "Service $SERVICE is already running with profile $live_profile." >&2
  else
    echo "Service $SERVICE is already running, but its live profile is unknown." >&2
  fi
  echo "Use ./scripts/restart $SERVICE --profile $PROFILE to switch profiles." >&2
  exit 1
fi

if [[ ! -x "$SERVICE_DIR/start.sh" ]]; then
  echo "Service start script is missing or not executable: $SERVICE_DIR/start.sh" >&2
  exit 1
fi

if [[ "$SERVICE" == "eliza-medium" ]]; then
  session_args=(env)
  # tmux's server may predate this shell and otherwise retain stale variables.
  for variable in MODEL_HOME HF_HOME LOG_DIR BASE_VENV RUNTIME_STATE_FILE SERVICE_SUPERVISOR_DIR \
    ELIZA_MEDIUM_PORT ELIZA_MEDIUM_AUTORESTART ELIZA_MEDIUM_RESTART_DELAY_SECONDS \
    ELIZA_MEDIUM_RESTART_MAX_DELAY_SECONDS ELIZA_MEDIUM_RESTART_RESET_SECONDS \
    SERVICE_SHUTDOWN_TIMEOUT_SECONDS LLAMA_SERVER_BIN LLAMA_MTP_DIR LLAMA_MTP_SERVER_BIN \
    LLAMA_QWEN4_MTP_DIR LLAMA_QWEN4_MTP_SERVER_BIN; do
    if [[ -v "$variable" ]]; then
      session_args+=("$variable=${!variable}")
    fi
  done
  session_args+=(bash "$ROOT_DIR/scripts/lib/run-service.sh" "$SERVICE" --profile "$PROFILE")
  printf -v session_command '%q ' "${session_args[@]}"
  session_command="exec $session_command"
  tmux new-session -d -s "$SESSION_NAME" -c "$ROOT_DIR" "$session_command"
else
  tmux new-session -d -s "$SESSION_NAME" "bash -lc 'cd \"$ROOT_DIR\" && set -a; [[ -f \"$ROOT_DIR/.env\" ]] && source \"$ROOT_DIR/.env\"; source \"$PROFILE_PATH\"; set +a; exec \"$SERVICE_DIR/start.sh\" 2>&1 | tee -a \"$LOG_FILE\"'"
fi

sleep "${START_LIVENESS_DELAY_SECONDS:-1}"
if ! tmux_has_session; then
  runtime_state clear --state "$RUNTIME_STATE_FILE" --service "$SERVICE" >/dev/null 2>&1 || true
  echo "Service $SERVICE exited during startup. Check logs: $LOG_FILE" >&2
  exit 1
fi

canonical_profile="${PROFILE_PATH#"$ROOT_DIR/configs/profiles/"}"
canonical_profile="${canonical_profile%.env}"
if ! runtime_state set --state "$RUNTIME_STATE_FILE" --service "$SERVICE" --profile "$canonical_profile"; then
  tmux kill-session -t "$SESSION_NAME" >/dev/null 2>&1 || true
  echo "Failed to record runtime state; stopped $SERVICE to avoid inconsistent state." >&2
  exit 1
fi

echo "Started $SERVICE with profile $canonical_profile in tmux session $SESSION_NAME"
echo "Logs: $LOG_FILE"
