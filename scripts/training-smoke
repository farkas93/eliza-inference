#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
source "$ROOT_DIR/scripts/lib/common.sh"
set -a
load_env
set +a
exec "${ELIZA_TRAINING_BOOTSTRAP_PYTHON:-/opt/eliza-training/bootstrap/bin/python}" -m nlp_training.smoke "$@"
