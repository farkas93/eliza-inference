#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck disable=SC1091
source "$ROOT_DIR/scripts/lib/common.sh"
load_env

DS4_DIR="${DS4_DIR:-$HOME/src/ds4}"
DS4_REPO="${DS4_REPO:-https://github.com/antirez/ds4}"
DS4_BIN="${DS4_BIN:-$HOME/.local/bin/ds4}"
DS4_BUILD_TARGET="${DS4_BUILD_TARGET:-}"
INSTALL_DS4="true"
UPDATE_SOURCE="true"
CHECK_ONLY="false"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-install)
      INSTALL_DS4="false"
      shift
      ;;
    --no-update)
      UPDATE_SOURCE="false"
      shift
      ;;
    --check)
      CHECK_ONLY="true"
      shift
      ;;
    --dir)
      DS4_DIR="${2:-}"
      shift 2
      ;;
    --bin)
      DS4_BIN="${2:-}"
      shift 2
      ;;
    --build-target)
      DS4_BUILD_TARGET="${2:-}"
      shift 2
      ;;
    -h|--help)
      cat <<USAGE
Usage: ./scripts/setup ds4 [options]

Builds ds4 (DwarfStar) from source and links its binaries for PATH usage.

Options:
  --no-install  Skip build/install and only verify current binary.
  --no-update   Do not git pull an existing clean checkout.
  --check       Only report how far the local checkout is behind upstream.
  --dir PATH    Source checkout path. Default: ~/src/ds4
  --bin PATH    Install symlink path for the main ds4 binary.
                Default: ~/.local/bin/ds4
  --build-target TARGET
                 make target (for example: cpu, cuda-spark, cuda-generic,
                 strix-halo). Default: auto-detected per platform.

Model downloads are handled by the upstream helper, e.g.
  ./scripts/download-models eliza-medium --profile medium/glm-5.3-flash-ds4-256k
USAGE
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

install_prereqs() {
  local missing=()
  local cmd

  for cmd in git make; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      missing+=("$cmd")
    fi
  done

  if ! command -v cc >/dev/null 2>&1 && ! command -v gcc >/dev/null 2>&1; then
    missing+=("build-essential")
  fi

  if [[ ${#missing[@]} -eq 0 ]]; then
    echo "[ok] ds4 build prerequisites are available"
    return 0
  fi

  if command -v apt-get >/dev/null 2>&1 && command -v sudo >/dev/null 2>&1; then
    echo "Installing ds4 prerequisites with apt: ${missing[*]}"
    sudo apt-get update
    sudo apt-get install -y build-essential git make
    return 0
  fi

  echo "Missing ds4 prerequisites: ${missing[*]}" >&2
  echo "Install them manually, then rerun ./scripts/setup ds4." >&2
  exit 1
}

ensure_source_checkout() {
  mkdir -p "$(dirname "$DS4_DIR")"

  if [[ ! -e "$DS4_DIR" ]]; then
    echo "Cloning ds4 into $DS4_DIR"
    git clone "$DS4_REPO" "$DS4_DIR"
    return 0
  fi

  if [[ ! -d "$DS4_DIR/.git" ]]; then
    echo "Path exists but is not a git checkout: $DS4_DIR" >&2
    exit 1
  fi

  if [[ "$UPDATE_SOURCE" != "true" ]]; then
    echo "Skipping ds4 source update (--no-update)."
    return 0
  fi

  local dirty
  dirty="$(git -C "$DS4_DIR" status --porcelain)"
  if [[ -n "$dirty" ]]; then
    echo "ds4 checkout has local changes; refusing to pull:" >&2
    git -C "$DS4_DIR" status --short >&2
    echo "Commit/stash those changes, rerun with --no-update, or set DS4_DIR to a clean checkout." >&2
    exit 1
  fi

  echo "Updating ds4 in $DS4_DIR"
  git -C "$DS4_DIR" pull --ff-only
}

detect_build_target() {
  if [[ "$(uname -s)" == "Darwin" ]]; then
    echo "all"
    return 0
  fi

  if command -v nvcc >/dev/null 2>&1; then
    local compute_cap=""
    if command -v nvidia-smi >/dev/null 2>&1; then
      compute_cap="$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | head -1 || true)"
    fi
    if [[ "$compute_cap" == 12.1* ]]; then
      echo "cuda-spark"
    else
      echo "cuda-generic"
    fi
    return 0
  fi

  if command -v hipcc >/dev/null 2>&1; then
    echo "strix-halo"
    return 0
  fi

  echo "cpu"
}

build_ds4() {
  local target="$DS4_BUILD_TARGET"

  if [[ -z "$target" ]]; then
    target="$(detect_build_target)"
  fi

  echo "Building ds4 (target: $target)"
  make -C "$DS4_DIR" "$target"

  if [[ ! -x "$DS4_DIR/ds4" ]]; then
    echo "Expected ds4 binary missing after build: $DS4_DIR/ds4" >&2
    exit 1
  fi
}

install_ds4_bin() {
  local bin_dir name link
  bin_dir="$(dirname "$DS4_BIN")"
  mkdir -p "$bin_dir"

  ln -sfn "$DS4_DIR/ds4" "$DS4_BIN"
  echo "Linked ds4 binary: $DS4_BIN -> $DS4_DIR/ds4"

  # ds4-server is the endpoint eliza-medium talks to; the rest are optional tools.
  for name in ds4-server ds4-agent ds4-bench ds4-eval; do
    if [[ -x "$DS4_DIR/$name" ]]; then
      link="$bin_dir/$name"
      ln -sfn "$DS4_DIR/$name" "$link"
      echo "Linked ds4 binary: $link -> $DS4_DIR/$name"
    fi
  done
}

print_ds4_version() {
  local out
  out="$($DS4_BIN --version 2>/dev/null || true)"
  if [[ -n "$out" ]]; then
    echo "$out"
    return 0
  fi
  "$DS4_BIN" --help 2>/dev/null | sed -n '1p' || true
}

report_upstream_drift() {
  local remote_ref upstream local_sha local_date upstream_date behind ahead

  if [[ ! -d "$DS4_DIR/.git" ]]; then
    echo "ds4 checkout not found at $DS4_DIR. Run ./scripts/setup ds4 to clone and build." >&2
    return 1
  fi

  remote_ref="$(git -C "$DS4_DIR" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [[ -z "$remote_ref" ]]; then
    remote_ref="refs/remotes/origin/main"
  fi

  echo "Fetching upstream ds4 in $DS4_DIR"
  if ! git -C "$DS4_DIR" fetch --quiet origin; then
    echo "Could not fetch upstream ds4. Check network access." >&2
    return 1
  fi

  if ! upstream="$(git -C "$DS4_DIR" rev-parse --verify "$remote_ref" 2>/dev/null)"; then
    echo "Upstream ref not found locally: $remote_ref" >&2
    return 1
  fi

  local_sha="$(git -C "$DS4_DIR" rev-parse HEAD)"
  behind="$(git -C "$DS4_DIR" rev-list --count "HEAD..$upstream")"
  ahead="$(git -C "$DS4_DIR" rev-list --count "$upstream..HEAD")"
  local_date="$(git -C "$DS4_DIR" log -1 --format=%cI HEAD)"
  upstream_date="$(git -C "$DS4_DIR" log -1 --format=%cI "$upstream")"

  echo "ds4 checkout:  $DS4_DIR"
  echo "  local:     ${local_sha:0:12}  $local_date"
  echo "  upstream:  ${upstream:0:12}  $upstream_date"
  echo "  behind:    $behind    ahead: $ahead"

  if [[ -f "$DS4_DIR/download_model.sh" ]] &&
    grep -q -- "glm53-q2" "$DS4_DIR/download_model.sh"; then
    echo "  GLM 5.3 Flash download target: available"
  else
    echo "  GLM 5.3 Flash download target: missing (checkout too old for medium/glm-5.3-flash-ds4-256k)"
  fi

  if [[ "$behind" -gt 0 ]]; then
    echo "ds4 is out of date: run ./scripts/setup ds4 to pull and rebuild."
    return 1
  fi

  echo "ds4 is up to date with upstream."
  return 0
}

if [[ "$CHECK_ONLY" == "true" ]]; then
  report_upstream_drift
  exit $?
fi

if [[ "$INSTALL_DS4" == "true" ]]; then
  install_prereqs
  ensure_source_checkout
  build_ds4
  install_ds4_bin
else
  echo "Skipping ds4 install (--no-install)."
fi

if [[ ! -x "$DS4_BIN" ]]; then
  echo "ds4 binary is not executable at $DS4_BIN" >&2
  exit 1
fi

echo "ds4 version/help:"
print_ds4_version

cat <<EOF

ds4 runtime is ready.

Source checkout:
$DS4_DIR

Binary:
$DS4_BIN
EOF
