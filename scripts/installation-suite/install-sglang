#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck disable=SC1091
source "$ROOT_DIR/scripts/lib/common.sh"
load_env

INSTALL_SGLANG="true"
CLEAN_SGLANG="false"
SGLANG_PACKAGE="sglang"
SGLANG_INSTALL_MODE="${SGLANG_INSTALL_MODE:-auto}"
SGLANG_SOURCE_DIR="${SGLANG_SOURCE_DIR:-$HOME/src/sglang-eliza}"
SGLANG_SOURCE_REF="${SGLANG_SOURCE_REF:-1cf2b8c54d81802abc15dcf23a29b9cc687bc01e}"
UV_TORCH_BACKEND="auto"
EXTRA_UV_PIP_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-install)
      INSTALL_SGLANG="false"
      shift
      ;;
    --clean)
      CLEAN_SGLANG="true"
      shift
      ;;
    --package)
      SGLANG_PACKAGE="${2:-}"
      shift 2
      ;;
    --mode)
      SGLANG_INSTALL_MODE="${2:-}"
      shift 2
      ;;
    --source-dir)
      SGLANG_SOURCE_DIR="${2:-}"
      shift 2
      ;;
    --source-ref)
      SGLANG_SOURCE_REF="${2:-}"
      shift 2
      ;;
    --torch-backend)
      UV_TORCH_BACKEND="${2:-}"
      shift 2
      ;;
    --index-url)
      EXTRA_UV_PIP_ARGS+=(--index-url "${2:-}")
      shift 2
      ;;
    --extra-index-url)
      EXTRA_UV_PIP_ARGS+=(--extra-index-url "${2:-}")
      shift 2
      ;;
    -h|--help)
      cat <<USAGE
Usage: ./scripts/setup sglang [options]

Installs and verifies SGLang for OpenAI-compatible serving.

Options:
  --no-install              Skip installation and only run verification.
  --clean                   Recreate the SGLang venv before installation.
  --package PACKAGE         SGLang package spec to install. Default: sglang
  --mode MODE               auto, package, or dgx-spark-source. Default: auto
  --source-dir PATH         Managed SGLang checkout for DGX Spark source mode.
                            Default: $SGLANG_SOURCE_DIR
  --source-ref REF          Tested SGLang revision for DGX Spark source mode.
                            Default: $SGLANG_SOURCE_REF
  --torch-backend BACKEND   uv torch backend. Default: auto
  --index-url URL           Pass an index URL to uv pip install.
  --extra-index-url URL     Pass an extra index URL to uv pip install.
USAGE
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

if ! command -v uv >/dev/null 2>&1; then
  echo "uv is required. Run ./scripts/setup prerequisites first." >&2
  exit 1
fi

if [[ "$CLEAN_SGLANG" == "true" ]]; then
  if [[ -z "$SGLANG_VENV" || "$SGLANG_VENV" == "/" ]]; then
    echo "Refusing to clean invalid SGLANG_VENV: $SGLANG_VENV" >&2
    exit 1
  fi
  echo "Removing existing SGLang environment: $SGLANG_VENV"
  rm -rf "$SGLANG_VENV"
fi

ensure_venv "$SGLANG_VENV"

if [[ "$SGLANG_INSTALL_MODE" == "auto" ]]; then
  gpu_names="$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null || true)"
  if [[ "$gpu_names" == *"GB10"* ]]; then
    SGLANG_INSTALL_MODE="dgx-spark-source"
  else
    SGLANG_INSTALL_MODE="package"
  fi
fi

if [[ "$SGLANG_INSTALL_MODE" != "package" && "$SGLANG_INSTALL_MODE" != "dgx-spark-source" ]]; then
  echo "Unsupported SGLang install mode: $SGLANG_INSTALL_MODE" >&2
  exit 2
fi

if [[ "$INSTALL_SGLANG" == "true" ]]; then
  if [[ "$SGLANG_INSTALL_MODE" == "dgx-spark-source" ]]; then
    if [[ -d "$SGLANG_SOURCE_DIR/.git" ]]; then
      if ! git -C "$SGLANG_SOURCE_DIR" diff --quiet || ! git -C "$SGLANG_SOURCE_DIR" diff --cached --quiet; then
        echo "SGLang source checkout has local changes: $SGLANG_SOURCE_DIR" >&2
        exit 1
      fi
      git -C "$SGLANG_SOURCE_DIR" fetch origin "$SGLANG_SOURCE_REF"
    else
      mkdir -p "$(dirname "$SGLANG_SOURCE_DIR")"
      git clone https://github.com/sgl-project/sglang.git "$SGLANG_SOURCE_DIR"
      git -C "$SGLANG_SOURCE_DIR" fetch origin "$SGLANG_SOURCE_REF"
    fi
    git -C "$SGLANG_SOURCE_DIR" checkout --detach "$SGLANG_SOURCE_REF"
    echo "Installing tested DGX Spark SGLang revision into $SGLANG_VENV: $SGLANG_SOURCE_REF"
    uv pip install \
      --python "$SGLANG_VENV/bin/python" \
      --prerelease=allow \
      -U \
      -e "$SGLANG_SOURCE_DIR/python[all]" \
      --torch-backend="$UV_TORCH_BACKEND" \
      "${EXTRA_UV_PIP_ARGS[@]}"
  else
    echo "Installing SGLang package into $SGLANG_VENV: $SGLANG_PACKAGE"
    uv pip install \
      --python "$SGLANG_VENV/bin/python" \
      --prerelease=allow \
      -U "$SGLANG_PACKAGE" \
      --torch-backend="$UV_TORCH_BACKEND" \
      "${EXTRA_UV_PIP_ARGS[@]}"
  fi
else
  echo "Skipping SGLang install (--no-install)."
fi

"$SGLANG_VENV/bin/python" - <<'PY'
from __future__ import annotations

import importlib.metadata as md
import platform
from pathlib import Path
import shutil
import subprocess
import sys

print("Python runtime:")
print(f"  executable={sys.executable}")
print(f"  version={sys.version.split()[0]}")
print(f"  platform={platform.platform()}")

print("\nPackage versions:")
for package in ("torch", "sglang", "sgl-kernel", "transformers", "tokenizers"):
    try:
        print(f"  {package}={md.version(package)}")
    except md.PackageNotFoundError:
        print(f"  {package}=not-installed")

try:
    import torch
except Exception as exc:
    raise SystemExit(f"Failed to import torch: {exc}") from exc

print("\nTorch CUDA:")
print(f"  torch.version.cuda={torch.version.cuda}")
cuda_available = torch.cuda.is_available()
print(f"  torch.cuda.is_available={cuda_available}")
if not cuda_available:
    raise SystemExit("torch CUDA is not available; SGLang is not ready for GPU serving")

try:
    import sglang  # noqa: F401
except Exception as exc:
    raise SystemExit(f"Failed to import sglang: {exc}") from exc

try:
    from sgl_kernel import sgl_per_token_quant_fp8  # noqa: F401
except Exception as exc:
    raise SystemExit(f"Failed to load native sgl_kernel FP8 operations: {exc}") from exc

sglang_cli = shutil.which("sglang")
print(f"\nsglang CLI on PATH: {sglang_cli or 'not-found-in-shell-path'}")

probe_commands: list[list[str]] = []

# Prefer the autoregressive module entrypoint used by the service launcher.
# The generic `sglang serve` command can import optional diffusion dependencies.
probe_commands.append([sys.executable, "-m", "sglang.launch_server", "--help"])

venv_cli = str(Path(sys.executable).with_name("sglang"))
if Path(venv_cli).exists():
    probe_commands.append([venv_cli, "serve", "--help"])

if sglang_cli:
    probe_commands.append([sglang_cli, "serve", "--help"])

probe_success = False
for command in probe_commands:
    try:
        completed = subprocess.run(
            command,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=30,
        )
        print(f"probe {' '.join(command)} exit_code={completed.returncode}")
        if completed.returncode == 0:
            probe_success = True
            break
    except Exception as exc:
        print(f"probe {' '.join(command)} failed: {exc}")

if not probe_success:
    raise SystemExit("No usable SGLang autoregressive server entrypoint was found")
PY

cat <<'EOF'

SGLang runtime is ready.

Recommended medium runtime comparison profile:
  ./scripts/start eliza-medium --profile medium/qwen3.8-27b-fp8-sglang-256k
  ./scripts/smoke-test eliza-medium --profile medium/qwen3.8-27b-fp8-sglang-256k
EOF
