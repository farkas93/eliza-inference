#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck disable=SC1091
source "$ROOT_DIR/scripts/lib/common.sh"
load_env

INSTALL_SGLANG="true"
SGLANG_PACKAGE="sglang"
UV_TORCH_BACKEND="auto"
EXTRA_UV_PIP_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-install)
      INSTALL_SGLANG="false"
      shift
      ;;
    --package)
      SGLANG_PACKAGE="${2:-}"
      shift 2
      ;;
    --torch-backend)
      UV_TORCH_BACKEND="${2:-}"
      shift 2
      ;;
    --index-url)
      EXTRA_UV_PIP_ARGS+=(--index-url "${2:-}")
      shift 2
      ;;
    --extra-index-url)
      EXTRA_UV_PIP_ARGS+=(--extra-index-url "${2:-}")
      shift 2
      ;;
    -h|--help)
      cat <<USAGE
Usage: ./scripts/setup sglang [options]

Installs and verifies SGLang for OpenAI-compatible serving.

Options:
  --no-install              Skip installation and only run verification.
  --package PACKAGE         SGLang package spec to install. Default: sglang
  --torch-backend BACKEND   uv torch backend. Default: auto
  --index-url URL           Pass an index URL to uv pip install.
  --extra-index-url URL     Pass an extra index URL to uv pip install.
USAGE
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

if ! command -v uv >/dev/null 2>&1; then
  echo "uv is required. Run ./scripts/setup prerequisites first." >&2
  exit 1
fi

ensure_venv "$SGLANG_VENV"

if [[ "$INSTALL_SGLANG" == "true" ]]; then
  echo "Installing SGLang package into $SGLANG_VENV: $SGLANG_PACKAGE"
  uv pip install --python "$SGLANG_VENV/bin/python" -U "$SGLANG_PACKAGE" --torch-backend="$UV_TORCH_BACKEND" "${EXTRA_UV_PIP_ARGS[@]}"
else
  echo "Skipping SGLang install (--no-install)."
fi

"$SGLANG_VENV/bin/python" - <<'PY'
from __future__ import annotations

import importlib.metadata as md
import platform
import shutil
import subprocess
import sys

print("Python runtime:")
print(f"  executable={sys.executable}")
print(f"  version={sys.version.split()[0]}")
print(f"  platform={platform.platform()}")

print("\nPackage versions:")
for package in ("torch", "sglang", "transformers", "tokenizers"):
    try:
        print(f"  {package}={md.version(package)}")
    except md.PackageNotFoundError:
        print(f"  {package}=not-installed")

try:
    import torch
except Exception as exc:
    raise SystemExit(f"Failed to import torch: {exc}") from exc

print("\nTorch CUDA:")
print(f"  torch.version.cuda={torch.version.cuda}")
cuda_available = torch.cuda.is_available()
print(f"  torch.cuda.is_available={cuda_available}")
if not cuda_available:
    raise SystemExit("torch CUDA is not available; SGLang is not ready for GPU serving")

try:
    import sglang  # noqa: F401
except Exception as exc:
    raise SystemExit(f"Failed to import sglang: {exc}") from exc

sglang_cli = shutil.which("sglang")
print(f"\nsglang CLI on PATH: {sglang_cli or 'not-found-in-shell-path'}")

completed = subprocess.run(
    [sys.executable, "-m", "sglang", "--help"],
    check=False,
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
    timeout=30,
)
print(f"sglang module help exit_code={completed.returncode}")
if completed.returncode != 0:
    raise SystemExit("SGLang module invocation failed")
PY

cat <<'EOF'

SGLang runtime is ready.

Recommended medium runtime comparison profile:
  ./scripts/start eliza-medium --profile medium/qwen3_6-27b-fp8-sglang-32k
  ./scripts/smoke-test eliza-medium --profile medium/qwen3_6-27b-fp8-sglang-32k
EOF
