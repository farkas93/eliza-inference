#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# Load operator settings without putting credentials in command-line arguments.
set -a
if [[ -f "$ROOT_DIR/.env" ]]; then
  # shellcheck disable=SC1091
  source "$ROOT_DIR/.env"
fi
set +a
exec python3 "$ROOT_DIR/scripts/lib/control_install.py" "$@"
