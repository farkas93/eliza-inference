#!/usr/bin/env bash
set -euo pipefail

COMMAND_NAME="download-models"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
source "$ROOT_DIR/scripts/lib/common.sh"
load_env
parse_service_profile "$@"
source_profile

if ! command -v uv >/dev/null 2>&1; then
  echo "uv is required." >&2
  exit 1
fi

if [[ ! -x "$BASE_VENV/bin/python" ]]; then
  echo "Base venv missing. Run ./scripts/setup prerequisites first." >&2
  exit 1
fi

mkdir -p "$MODEL_HOME" "$HF_HOME"

hf_download() {
  if "$BASE_VENV/bin/hf" --help >/dev/null 2>&1; then
    "$BASE_VENV/bin/hf" download "$@"
    return 0
  fi

  if "$BASE_VENV/bin/huggingface-cli" --help >/dev/null 2>&1; then
    "$BASE_VENV/bin/huggingface-cli" download "$@"
    return 0
  fi

  echo "Neither 'hf' nor 'huggingface-cli' is available through uv." >&2
  echo "Run ./scripts/setup prerequisites, then retry." >&2
  return 1
}

case "$SERVICE" in
  eliza-medium)
    if [[ "${BACKEND:-vllm}" == "llamacpp" ]]; then
      mkdir -p "$MODEL_DIR"
      echo "Downloading llama.cpp GGUF files from $MODEL_REPO into $MODEL_DIR"
      hf_download "$MODEL_REPO" \
        --include "${HF_INCLUDE_MODEL:-$MODEL_FILE}" \
        --local-dir "$MODEL_DIR"
    elif [[ "${BACKEND:-vllm}" == "ds4" ]]; then
      mkdir -p "$MODEL_DIR"
      if [[ -n "${MODEL_REPO:-}" && -n "${MODEL_FILE:-}" ]]; then
        echo "Downloading ds4 GGUF model from $MODEL_REPO into $MODEL_DIR"
        hf_download "$MODEL_REPO" \
          --include "$MODEL_FILE" \
          --local-dir "$MODEL_DIR"
      elif [[ -x "${DS4_DIR:-$HOME/src/ds4}/download_model.sh" ]]; then
        echo "Using ds4 model helper script"
        "${DS4_DIR:-$HOME/src/ds4}/download_model.sh" "${DS4_MODEL_PRESET:-q2-imatrix}"
      else
        echo "No ds4 model source configured. Set MODEL_REPO/MODEL_FILE or install ds4 with download_model.sh" >&2
        exit 1
      fi
    else
      snapshot_dir="${MODEL_DIR:-$HF_HOME/hub/$MODEL_ID}"
      echo "Downloading/syncing Hugging Face snapshot: $MODEL_ID into $snapshot_dir"
      hf_download "$MODEL_ID" --local-dir "$snapshot_dir"
    fi
    ;;
  eliza-small)
    if [[ "${BACKEND:-llamacpp}" == "llamacpp" ]]; then
      mkdir -p "$MODEL_DIR"
      echo "Downloading voice GGUF files from $MODEL_REPO into $MODEL_DIR"
      hf_download "$MODEL_REPO" \
        --include "$MODEL_FILE" \
        --include "${MMPROJ_FILE:-mmproj-BF16.gguf}" \
        --local-dir "$MODEL_DIR"
    else
      snapshot_dir="${MODEL_DIR:-$HF_HOME/hub/$MODEL_ID}"
      echo "Downloading/syncing model snapshot: $MODEL_ID into $snapshot_dir"
      hf_download "$MODEL_ID" --local-dir "$snapshot_dir"
    fi
    ;;
  stt)
    if [[ "${BACKEND:-faster-whisper}" == "faster-whisper" ]]; then
      mkdir -p "$MODEL_DIR"
      echo "Downloading/syncing faster-whisper model: $MODEL_ID"
      hf_download "$MODEL_ID" --local-dir "$MODEL_DIR"
    else
      echo "Automatic download for STT backend '${BACKEND:-}' is not implemented. Configure MODEL_DIR/MODEL_FILE manually." >&2
      exit 1
    fi
    ;;
  tts)
    if [[ "${BACKEND:-piper}" == "piper" ]]; then
      mkdir -p "$MODEL_DIR"
      echo "Downloading Piper voice files from $MODEL_REPO into $MODEL_DIR"
      hf_download "$MODEL_REPO" \
        --include "${HF_INCLUDE_MODEL:-$MODEL_FILE}" \
        --include "${HF_INCLUDE_CONFIG:-$MODEL_CONFIG_FILE}" \
        --local-dir "$MODEL_DIR"
    else
      echo "Automatic download for TTS backend '${BACKEND:-}' is not implemented." >&2
      exit 1
    fi
    ;;
  *)
    echo "Unsupported service for downloads: $SERVICE" >&2
    exit 2
    ;;
esac
