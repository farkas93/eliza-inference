#!/usr/bin/env bash
set -euo pipefail

COMMAND_NAME="download-models"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
source "$ROOT_DIR/scripts/lib/common.sh"
load_env
parse_service_profile "$@"
source_profile

if ! command -v uv >/dev/null 2>&1; then
  echo "uv is required." >&2
  exit 1
fi

if [[ ! -x "$BASE_VENV/bin/python" ]]; then
  echo "Base venv missing. Run ./scripts/setup prerequisites first." >&2
  exit 1
fi

mkdir -p "$MODEL_HOME" "$HF_HOME"

hf_download() {
  if "$BASE_VENV/bin/hf" --help >/dev/null 2>&1; then
    "$BASE_VENV/bin/hf" download "$@"
    return 0
  fi

  if "$BASE_VENV/bin/huggingface-cli" --help >/dev/null 2>&1; then
    "$BASE_VENV/bin/huggingface-cli" download "$@"
    return 0
  fi

  echo "Neither 'hf' nor 'huggingface-cli' is available through uv." >&2
  echo "Run ./scripts/setup prerequisites, then retry." >&2
  return 1
}

case "$SERVICE" in
  eliza-medium)
    if [[ "${BACKEND:-vllm}" == "llamacpp" ]]; then
      mkdir -p "$MODEL_DIR"
      echo "Downloading llama.cpp GGUF files from $MODEL_REPO into $MODEL_DIR"
      hf_download "$MODEL_REPO" \
        --include "${HF_INCLUDE_MODEL:-$MODEL_FILE}" \
        --local-dir "$MODEL_DIR"
    elif [[ "${BACKEND:-vllm}" == "ds4" ]]; then
      mkdir -p "$MODEL_DIR"
      if [[ -n "${MODEL_REPO:-}" && -n "${MODEL_FILE:-}" ]]; then
        echo "Downloading ds4 GGUF model from $MODEL_REPO into $MODEL_DIR"
        hf_download "$MODEL_REPO" \
          --include "$MODEL_FILE" \
          --local-dir "$MODEL_DIR"
      elif [[ -x "${DS4_DIR:-$HOME/src/ds4}/download_model.sh" ]]; then
        echo "Using ds4 model helper script"
        export PATH="$BASE_VENV/bin:$PATH"
        if [[ -z "${HF_TOKEN:-}" && -s "$HF_HOME/token" ]]; then
          HF_TOKEN="$(cat "$HF_HOME/token")"
          export HF_TOKEN
        fi
        DS4_GGUF_DIR="$MODEL_DIR" "${DS4_DIR:-$HOME/src/ds4}/download_model.sh" \
          "${DS4_MODEL_PRESET:-ds4f-q2}"
      else
        echo "No ds4 model source configured. Set MODEL_REPO/MODEL_FILE, DS4_MODEL_PRESET, or install ds4 with download_model.sh" >&2
        exit 1
      fi
    elif [[ "${BACKEND:-vllm}" == "flash" ]]; then
      flash_repo="${FLASH_REPO:-$HOME/src/qwen3.8-Flash-DGX}"
      flash_image="${FLASH_IMAGE:-qwen38-flash-dgx}"
      flash_model="${FLASH_MODEL:-nvidia/Qwen3.8-Flash-Next-NVFP4}"
      flash_cache="${FLASH_HF_CACHE:-$HF_HOME}"

      if [[ ! -x "$flash_repo/scripts/download-weights.sh" ]]; then
        echo "flash recipe not found at $flash_repo. Run ./scripts/setup flash first." >&2
        exit 1
      fi

      if ! docker image inspect "$flash_image" >/dev/null 2>&1; then
        echo "flash image $flash_image is not built. Run ./scripts/setup flash first." >&2
        exit 1
      fi

      mkdir -p "$flash_cache"
      IMAGE="$flash_image" MODEL="$flash_model" HF_CACHE="$flash_cache" \
      XET="${FLASH_XET:-1}" MAX_WORKERS="${FLASH_MAX_WORKERS:-8}" EXCLUDE="${FLASH_EXCLUDE:-}" \
        "$flash_repo/scripts/download-weights.sh"

      case "${FLASH_MODE:-hybrid}" in
        hybrid)
          if [[ "${FLASH_PREPARE_HYBRID:-true}" == "true" ]]; then
            IMAGE="$flash_image" MODEL="$flash_model" HF_CACHE="$flash_cache" \
              "$flash_repo/scripts/prepare-hybrid.sh"
          fi
          ;;
        hybrid-mtp)
          echo "FLASH_MODE=hybrid-mtp also needs $flash_repo/scripts/prepare-mtp-graft.sh (RadixArk checkpoints only)." >&2
          ;;
      esac
    elif [[ "${BACKEND:-vllm}" == "ds4dfm" ]]; then
      mkdir -p "$MODEL_DIR"
      ds4dfm_repo="${DS4DFM_HF_REPO:-Baekpica/Qwen3.8-Flash-Next-Mixed-Quant-SSD-PLE-GGUF}"
      q5_dir="$MODEL_DIR/MQ-Q5-SSD-PLE-BF16"
      echo "Downloading ds4dfm Qwen3.8 Flash Next artifacts from $ds4dfm_repo into $MODEL_DIR"
      if [[ -f "$MODEL_DIR/$MODEL_FILE" && -d "$MODEL_DIR/MQ-Q6-SSD-PLE-BF16/ple" ]]; then
        if [[ ! -e "$q5_dir/ple" ]]; then
          ln -sfn ../MQ-Q6-SSD-PLE-BF16/ple "$q5_dir/ple"
          echo "Repaired $q5_dir/ple -> ../MQ-Q6-SSD-PLE-BF16/ple (existing sidecar)"
        fi
        echo "ds4dfm artifacts already present; skipping download"
        exit 0
      fi
      hf_download "$ds4dfm_repo" \
        --include "MQ-Q5-SSD-PLE-BF16/*" \
        --local-dir "$MODEL_DIR"
      hf_download "$ds4dfm_repo" \
        --include "MQ-Q6-SSD-PLE-BF16/ple/*" \
        --local-dir "$MODEL_DIR"
      if [[ ! -e "$q5_dir/ple" ]]; then
        ln -sfn ../MQ-Q6-SSD-PLE-BF16/ple "$q5_dir/ple"
        echo "Linked $q5_dir/ple -> ../MQ-Q6-SSD-PLE-BF16/ple (shared BF16 sidecar)"
      fi
      if [[ "${DS4DFM_VERIFY_ARTIFACTS:-false}" == "true" ]]; then
        echo "Verifying artifacts against SHA256SUMS (reads ~173 GiB)"
        (
          cd "$q5_dir"
          sha256sum --check SHA256SUMS
        )
      fi
    else
      snapshot_dir="${MODEL_DIR:-$HF_HOME/hub/$MODEL_ID}"
      echo "Downloading/syncing Hugging Face snapshot: $MODEL_ID into $snapshot_dir"
      hf_download "$MODEL_ID" --local-dir "$snapshot_dir"
    fi
    ;;
  eliza-small)
    if [[ "${BACKEND:-llamacpp}" == "llamacpp" ]]; then
      mkdir -p "$MODEL_DIR"
      echo "Downloading voice GGUF files from $MODEL_REPO into $MODEL_DIR"
      hf_download "$MODEL_REPO" \
        --include "$MODEL_FILE" \
        --include "${MMPROJ_FILE:-mmproj-BF16.gguf}" \
        --local-dir "$MODEL_DIR"
    else
      snapshot_dir="${MODEL_DIR:-$HF_HOME/hub/$MODEL_ID}"
      echo "Downloading/syncing model snapshot: $MODEL_ID into $snapshot_dir"
      hf_download "$MODEL_ID" --local-dir "$snapshot_dir"
    fi
    ;;
  stt)
    if [[ "${BACKEND:-faster-whisper}" == "faster-whisper" ]]; then
      mkdir -p "$MODEL_DIR"
      echo "Downloading/syncing faster-whisper model: $MODEL_ID"
      hf_download "$MODEL_ID" --local-dir "$MODEL_DIR"
    else
      echo "Automatic download for STT backend '${BACKEND:-}' is not implemented. Configure MODEL_DIR/MODEL_FILE manually." >&2
      exit 1
    fi
    ;;
  tts)
    if [[ "${BACKEND:-piper}" == "piper" ]]; then
      mkdir -p "$MODEL_DIR"
      echo "Downloading Piper voice files from $MODEL_REPO into $MODEL_DIR"
      hf_download "$MODEL_REPO" \
        --include "${HF_INCLUDE_MODEL:-$MODEL_FILE}" \
        --include "${HF_INCLUDE_CONFIG:-$MODEL_CONFIG_FILE}" \
        --local-dir "$MODEL_DIR"
    else
      echo "Automatic download for TTS backend '${BACKEND:-}' is not implemented." >&2
      exit 1
    fi
    ;;
  *)
    echo "Unsupported service for downloads: $SERVICE" >&2
    exit 2
    ;;
esac
