# Global defaults for local DGX Spark inference services.
# Copy to .env and edit if needed.

MODEL_HOME="$HOME/models"
HF_HOME="$MODEL_HOME/huggingface"
LLAMA_CACHE="$MODEL_HOME/llama"
LOG_DIR="$PWD/logs"

# Services bind to LAN by default. Do not expose these ports to the public internet.
DEFAULT_HOST="0.0.0.0"
ELIZA_MEDIUM_PORT="8001"
ELIZA_SMALL_PORT="8002"
STT_PORT="8011"
TTS_PORT="8012"
VOCODE_BRIDGE_PORT="8021"

# Optional control-daemon protection. Leave empty for trusted-LAN access without authentication.
CONTROL_DAEMON_TOKEN=""
CONTROL_START_TIMEOUT_SECONDS="1200"
CONTROL_STOP_TIMEOUT_SECONDS="180"
CONTROL_STATUS_TIMEOUT_SECONDS="30"

# Optional explicit binary paths.
VLLM_BIN="vllm"
LLAMA_SERVER_BIN="llama-server"
PIPER_BIN="piper"

# Optional flash backend (Qwen3.8-Flash-Next in Docker, DGX Spark only).
FLASH_REPO="$HOME/src/qwen3.8-Flash-DGX"
FLASH_IMAGE="qwen38-flash-dgx"
FLASH_CONTAINER="qwen38-flash"
FLASH_HF_CACHE="$HF_HOME"

# Optional ds4dfm backend (native Rust-host DwarfStar, DGX Spark only).
DS4DFM_DIR="$HOME/src/ds4-dfm-rs"
# Set only when running a persistent weight owner (see docs/eliza-medium.md):
# DS4_CUDA_WEIGHT_IPC_MANIFEST="/tmp/ds4dfm-weights.manifest"
# DS4_CUDA_WEIGHT_IPC_SCOPE="base"

# Vocode or other orchestrators can use these URLs.
STT_BASE_URL="http://127.0.0.1:8011/v1"
ELIZA_SMALL_BASE_URL="http://127.0.0.1:8002/v1"
ELIZA_MEDIUM_BASE_URL="http://127.0.0.1:8001/v1"
TTS_BASE_URL="http://127.0.0.1:8012/v1"
VOCODE_BRIDGE_BASE_URL="ws://127.0.0.1:8021/ws"
